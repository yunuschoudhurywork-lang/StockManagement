# Server Configuration
# Port number for the Express server (default: 5000)
PORT=5000

# MongoDB Atlas Connection
# Get this from MongoDB Atlas: Database -> Connect -> Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Replace <username>, <password>, <cluster>, and <database> with your actual values
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/student_management?retryWrites=true&w=majority

# CORS Configuration
# Allowed origin for Cross-Origin Resource Sharing (default: http://localhost:5000)
# For production, replace with your actual frontend URL
CORS_ORIGIN=http://localhost:5000
