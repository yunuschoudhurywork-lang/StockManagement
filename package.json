{
  "name": "student-management-crud",
  "version": "1.0.0",
  "description": "Simple student management CRUD app using Express, MongoDB Atlas, Tailwind CDN, and plain JavaScript.",
  "main": "server.js",
  "scripts": {
    "start": "node start-server.js",
    "dev": "nodemon start-server.js",
    "test": "jest --verbose --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration"
  },
  "keywords": [
    "express",
    "mongodb",
    "crud",
    "tailwind",
    "student-management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/globalSetup.js",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testTimeout": 60000,
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/*.config.js",
      "!**/public/**",
      "!**/tests/**",
      "!server.js",
      "!config/**"
    ]
  }
}
